--- !u!114 &614435203
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 614435202}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 647e734b59584964e862507086fac333, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  subtitlePanel: {fileID: 1269090334}
  subtitleText: {fileID: 11058110}
  audioSource: {fileID: 614435204}
  EsperaInicial: 2
  dialogue:
  - audio: {fileID: 8300000, guid: 798cb1955f3db0740a557c3bc3da2534, type: 3}
    subtitle: "\xA1Wow! La sala est\xE1 llena."
  - audio: {fileID: 8300000, guid: 8cf774544e802304dbf2d6822a654766, type: 3}
    subtitle: "Volvimos a la sala de trofeos porque quer\xEDa decirte algo."
  - audio: {fileID: 8300000, guid: daf53b7d04ab52847ba867c083974486, type: 3}
    subtitle: "Mira a tu alrededor\u2026 Cada reto superado est\xE1 aqu\xED porque
      t\xFA lo lograste."
  - audio: {fileID: 8300000, guid: b695c01ac026b49468ba07e969b5d052, type: 3}
    subtitle: "Estos no son solo trofeos y medallas, son pruebas de tu esfuerzo,
      de c\xF3mo fuiste capaz de aplicar lo aprendido paso a paso."
  - audio: {fileID: 8300000, guid: 06fb4f3c8b9548145a8178975729cf18, type: 3}
    subtitle: "Yo siempre fui tu gu\xEDa, pero nunca tu respuesta. La verdadera fuerza
      vino de ti, de tu mente y de tu forma de pensar cada problema."
  - audio: {fileID: 8300000, guid: d3d6b53532fab4e498f5601f9967202c, type: 3}
    subtitle: "Hoy entiendes que el torque no es solo una f\xF3rmula: es el poder
      de transformar, de mover el mundo aplicando la fuerza en el lugar correcto."
  - audio: {fileID: 8300000, guid: 591ed12dbb3ff2a4db1c15c7d5940b4a, type: 3}
    subtitle: "Y recuerda\u2026 Lo que lograste aqu\xED no se queda en este laboratorio,
      se queda contigo. Ahora eres capaz de usar este conocimiento en tu vida real
      y acad\xE9mica."
