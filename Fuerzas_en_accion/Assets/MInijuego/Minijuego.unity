  m_EditorClassIdentifier: 
  subtitleText: {fileID: 0}
  subtitlePanel: {fileID: 0}
  audioSource: {fileID: 2121402368}
  dialogue:
  - audio: {fileID: 8300000, guid: 9d38a5b801ba78d43b0458ab8d47b9a2, type: 3}
    subtitle: "Como ves, el torque est\xE1 en todas partes: desde abrir una puerta
      hasta andar en bicicleta. Y pronto, lo usar\xE1s para resolver tus propios
      retos"
  - audio: {fileID: 8300000, guid: cbe9e98946acc9d4588e3d2a6d98d022, type: 3}
    subtitle: "\xBFQuieres ir a ver m\xE1s videos para aprender sobre el torque o
      puedes continuar con los retos?"
--- !u!114 &2121402367
MonoBehaviour:
  m_ObjectHideFlags: 0
