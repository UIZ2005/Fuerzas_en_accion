  m_Name: 
  m_EditorClassIdentifier: 
  videoClip: {fileID: 32900000, guid: d1a83ee54978fc544991220738e93d09, type: 3}
  pregunta:
    texto: "En el sistema mostrado, \xBFc\xF3mo se determina la direcci\xF3n del
      vector torque a partir del sentido de rotaci\xF3n en el plano?"
    opciones:
    - "La direcci\xF3n del torque siempre coincide con la direcci\xF3n de la fuerza
      aplicada."
    - "El torque no tiene direcci\xF3n, solo magnitud y sentido de giro."
    - "La direcci\xF3n del torque depende \xFAnicamente de la distancia al punto
      de giro."
    - "La direcci\xF3n del torque se obtiene usando la regla de la mano derecha,
      donde el pulgar indica la direcci\xF3n del vector."
    respuestaCorrecta: 3
    tiempoEnVideo: 105
