  dialogue:
  - audio: {fileID: 8300000, guid: cbc41cec78946fd4387f55462e731503, type: 3}
    subtitle: "Antes de entrenar, d\xE9jame mostrarte c\xF3mo el torque est\xE1 presente
      en lo cotidiano."
  - audio: {fileID: 8300000, guid: aeccc375c35ad324a98aee7250eb9e8f, type: 3}
    subtitle: "Ven, s\xEDgueme.."
  - audio: {fileID: 8300000, guid: eec4b869f26e8ef429578aa19b976268, type: 3}
    subtitle: "Puedes acercarte a cualquiera de estos hologramas y aprender sobre
      la teor\xEDa del torque"
  - audio: {fileID: 8300000, guid: a6a48a41c1230bb48a8bd49e211b7492, type: 3}
    subtitle: Selecciona un video dando click y aprende
